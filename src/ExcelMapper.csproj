<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!--
      Ship the XML documentation in the package, so the doc comments show in IntelliSense, and fail
      the build on missing or broken doc comments (undocumented public members, wrong parameter
      names, unresolved references).
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every warning is an error, so none build up unnoticed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Runs the code style rules turned on in .editorconfig, such as IDE0005 (unused usings), in the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1710;CS1711;CS1712;CS1723;CS1734</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Run the trimming and native AOT analyzers on the net8.0 build, and fail the build on their
    warnings, so new code stays annotated. Reflection-based mapping is marked with
    RequiresUnreferencedCode/RequiresDynamicCode, so apps that trim get warnings where they call it.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2111;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ExcelDataReader.Mapping</PackageId>
    <PackageVersion>4.0.0</PackageVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Hugh Bellamy</Authors>
    <Title>Excel Mapper</Title>
    <Description>An extension of ExcelDataReader that supports fluent mapping of rows to C# objects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/hughbe/excel-mapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hughbe/excel-mapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright 2026 (c) Hugh Bellamy. All rights reserved.</Copyright>
    <PackageTags>excel;mapping;mapper;excel-mapper</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!--
      Check the package against the last release for breaking changes (and that the target
      frameworks in the package are consistent). Intentional breaks are listed, with reasons, in
      CompatibilitySuppressions.xml; regenerate it with
      dotnet pack -c Release -p:GenerateCompatibilitySuppressionFile=true
      (regenerating drops the comments that give the reasons: add them back) and update the
      baseline after each release.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.0.3</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IndexRange" Version="1.1.1" />
    <PackageReference Include="ExcelNumberFormat" Version="1.2.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Nullable" Version="1.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <!-- netstandard targets stay on 9.0.x so consumers on older runtimes are not forced onto 10.x. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Collections.Immutable" Version="9.0.9" />
    <!-- Code page encodings are built in on .NET 8. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.9" />
  </ItemGroup>

  <!--
    The public API of each target framework is listed in PublicAPI/<framework>/: changing it without
    changing the list fails the build, so every change to the public API is deliberate and shows in
    review. New APIs go in PublicAPI.Unshipped.txt, and move to PublicAPI.Shipped.txt when a version
    is released. See docs/Architecture.md.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup>
    <!-- RS0016/RS0017: an API added or removed without updating the list; the others: the lists themselves are malformed or out of date. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0022;RS0024;RS0025;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The source generator for ExcelMappingContext ships in this package, as an analyzer: built
    first, and packed under analyzers/dotnet/cs, which compilers load for C# projects that reference
    the package. It isn't referenced by the library itself.
  -->
  <ItemGroup>
    <!-- No SetTargetFramework: the generator has one target, and building it with the same properties as the tests' and the solution's references builds it once rather than twice at the same time. -->
    <ProjectReference Include="../gen/ExcelMapper.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../gen/bin/$(Configuration)/netstandard2.0/ExcelMapper.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

</Project>
