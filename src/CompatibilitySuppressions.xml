<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--
    4.0.0: CallerArgumentExpressionAttribute was a polyfill for netstandard that was accidentally
    public and in the global namespace, so the compiler ignored it (argument exceptions had no
    parameter names on netstandard). It is now internal, in System.Runtime.CompilerServices.
  -->
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:CallerArgumentExpressionAttribute</Target>
    <Left>lib/netstandard2.0/ExcelMapper.dll</Left>
    <Right>lib/netstandard2.0/ExcelMapper.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:CallerArgumentExpressionAttribute</Target>
    <Left>lib/netstandard2.1/ExcelMapper.dll</Left>
    <Right>lib/netstandard2.1/ExcelMapper.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>