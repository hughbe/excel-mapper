<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes a trimmed app that maps rows, to check that the trimming annotations keep what mapping
    needs. CI runs: dotnet publish tests/TrimmingTests -c Release -r linux-x64 -o out && out/TrimmingTests
    The app calls reflection-based mapping on purpose, so the IL2026/IL3050 warnings are expected.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ExcelMapper.csproj" />
  </ItemGroup>

</Project>
