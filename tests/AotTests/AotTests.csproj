<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes a native AOT app that maps rows, to check what mapping supports under native AOT. CI
    runs: dotnet publish tests/AotTests -c Release -r linux-x64 -o out && out/AotTests
    Reading rows with a mapping context must not warn, so trimming and AOT warnings are errors. The
    cases that call the reflection-based APIs on purpose suppress them (see ClassMapCases).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050;IL3053</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ExcelMapper.csproj" />
    <ProjectReference Include="../../gen/ExcelMapper.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
